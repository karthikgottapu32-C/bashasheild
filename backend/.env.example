# BhashaShield Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SQLite Database
DATABASE_PATH=backend/data/bhashashield.db

# Optional Gemini Integration for explanatory insights
# Note: Detection runs locally and deterministically without requiring an API key.
GEMINI_API_KEY=

# ML Model Settings
MODEL_PATH=backend/data/muril_classifier.joblib
USE_ML_MODEL=true
