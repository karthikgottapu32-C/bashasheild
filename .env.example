# ==============================================================================
# BHASHASHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your environment.
# NEVER commit actual secrets, API keys, or private credentials to source control.
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# In containerized/Docker deployment, point to persistent volume path
DATABASE_PATH=backend/data/bhashashield.db

# Optional AI Analysis Enhancer (Google Gemini API)
# Detection runs 100% deterministically and offline without requiring this key.
# Only required if AI-generated explanatory remediation advice is desired.
GEMINI_API_KEY=

# ML Model Configuration
MODEL_PATH=backend/data/muril_classifier.joblib
USE_ML_MODEL=true

# Security Settings
MAX_INPUT_LENGTH=10000

# Frontend Configuration (Vite)
# Leave blank for local development to use Vite reverse-proxy.
# In production, set to your backend domain: e.g. https://api.bhashashield.internal
VITE_API_URL=
